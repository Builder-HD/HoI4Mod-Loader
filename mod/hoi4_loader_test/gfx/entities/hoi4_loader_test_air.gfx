# hoi4_loader test mod: meshes (skeleton + animations) of the air scenario tests. They reuse vanilla's skeletons and animations,
# so no new 3D files are needed.
#   bomber_1_CAS:           one joint "fighter",                         animation default
#   fighter_1_vs_fighter_1: joints "fighter1" (attacker), "fighter2" (defender), pass / success / fail
#   fighter_1_vs_bomber_1:  joints "fighter" (attacker), "bomber" (defender),     pass / success
objectTypes = {
	# Vanilla's patrol skeleton (one joint "fighter", flying in circles): a CAS plane that orbits.
	pdxmesh = {
		name = "hlt_air_orbit_mesh"
		file = "gfx/models/units/planes/fighter_1_patrol.mesh"
		animation = { id = "default" type = "fighter_1_patrol_animation" }
	}
	# 1 vs 1 where "pass" plays vanilla's "success" flight: a long chase.
	pdxmesh = {
		name = "hlt_air_chase_mesh"
		file = "gfx/models/units/planes/fighter_1_vs_fighter_1.mesh"
		animation = { id = "pass" 		type = "fighter_1_vs_fighter_1_success_animation" }
		animation = { id = "success" 	type = "fighter_1_vs_fighter_1_success_animation" }
		animation = { id = "fail" 		type = "fighter_1_vs_fighter_1_fail_animation" }
	}
	pdxmesh = {
		name = "hlt_air_head_on_mesh"
		file = "gfx/models/units/planes/fighter_1_vs_fighter_1.mesh"
		animation = { id = "pass" 		type = "fighter_1_vs_fighter_1_pass_animation" }
		animation = { id = "success" 	type = "fighter_1_vs_fighter_1_success_animation" }
		animation = { id = "fail" 		type = "fighter_1_vs_fighter_1_fail_animation" }
	}
	pdxmesh = {
		name = "hlt_air_interception_mesh"
		file = "gfx/models/units/planes/fighter_1_vs_bomber_1.mesh"
		animation = { id = "pass" 		type = "fighter_1_vs_bomber_1_pass_animation" }
		animation = { id = "success" 	type = "fighter_1_vs_bomber_1_success_animation" }
	}
}
